{
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "maxLength": 128
    },
    "boss_cdp_endpoint": {
      "type": "string",
      "maxLength": 256
    },
    "resume_roots": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "key",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
