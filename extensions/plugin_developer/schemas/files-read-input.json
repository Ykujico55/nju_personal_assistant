{
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^cand_[a-f0-9]{32}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32000
    }
  },
  "required": [
    "candidate_id",
    "path"
  ],
  "additionalProperties": false
}
