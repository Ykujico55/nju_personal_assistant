{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal knowledge roots",
  "type": "object",
  "properties": {
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "key": {"type": "string", "minLength": 1, "maxLength": 64},
          "label": {"type": "string", "maxLength": 128}
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "include_hidden": {"type": "boolean"},
    "max_file_bytes": {"type": "integer", "minimum": 1024, "maximum": 104857600},
    "embedding": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "enum": ["none", "ollama"]},
        "base_url": {"type": "string", "maxLength": 512},
        "model": {"type": "string", "maxLength": 128},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 120}
      },
      "additionalProperties": false
    }
  },
  "required": ["roots"],
  "additionalProperties": false
}
