      "source": "USER_INPUT"
    },
    {
      "field_id": "phone",
      "label": "联系电话",
      "kind": "text",
      "required": true,
      "max_length": 20,
      "pattern": "1[0-9]{10}",
      "locator": "ctl:0:1",
      "source": "USER_INPUT"
    },
    {
      "field_id": "delivery",
      "label": "领取方式",
