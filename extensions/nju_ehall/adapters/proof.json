      "kind": "submit",
      "risk": "EXTERNAL_WRITE",
      "final": true,
      "method": "POST",
      "target_path": "/apps/proof/submit"
    },
    {
      "action_id": "proof.open",
      "locator": "act:0",
      "label": "在读证明申请",
      "kind": "navigate",
      "risk": "INTERNAL_WRITE",
      "transaction_id": "proof.apply",
      "navigates_to_path": "/apps/proof"
