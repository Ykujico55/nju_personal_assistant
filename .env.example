# Development boots with in-memory adapters. Production must use postgres.
PA_ENVIRONMENT=development
PA_LOG_LEVEL=INFO
PA_PUBLIC_HOST=127.0.0.1
PA_PUBLIC_PORT=8000
PA_ADMIN_HOST=127.0.0.1
PA_ADMIN_PORT=8001
PA_HEALTH_HOST=127.0.0.1
PA_HEALTH_PORT=8010
PA_STORAGE_BACKEND=memory
PA_DATABASE_URL=postgresql+asyncpg://assistant:change-me@127.0.0.1:5432/assistant
PA_EXTENSION_ROOT=./var/extensions
PA_ARTIFACT_ROOT=./var/artifacts
PA_TRUST_CLOUDFLARE_ACCESS=false
PA_PUBLIC_ORIGIN=

# Configure these only when Cloudflare Access protects the public listener.
PA_CF_ACCESS_TEAM_DOMAIN=
PA_CF_ACCESS_AUD=
