# Development boots with in-memory adapters. Production must use postgres.
PA_ENVIRONMENT=development
PA_LOG_LEVEL=INFO
PA_PUBLIC_HOST=127.0.0.1
PA_PUBLIC_PORT=8000
PA_ADMIN_HOST=127.0.0.1
PA_ADMIN_PORT=8001
PA_HEALTH_HOST=127.0.0.1
PA_HEALTH_PORT=8010
PA_STORAGE_BACKEND=memory
PA_DATABASE_URL=postgresql+asyncpg://assistant:change-me@127.0.0.1:5432/assistant
PA_EXTENSION_ROOT=./var/extensions
PA_ARTIFACT_ROOT=./var/artifacts
PA_TRUST_CLOUDFLARE_ACCESS=false
# Required with Cloudflare Access: the exact browser origin, e.g. https://assistant.example.com
PA_PUBLIC_ORIGIN=

# Configure these only when Cloudflare Access protects the public listener.
# Team domain accepts `team`, `team.cloudflareaccess.com` or
# `https://team.cloudflareaccess.com`; any other host/scheme/port/path is rejected.
PA_CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application settings.
PA_CF_ACCESS_AUD=

# Model endpoints are opt-in and validated at startup. A remote endpoint
# requires an https base URL, a model id and a SecretHandle id (never the key
# itself); a local endpoint must be a loopback address. Partial configuration
# refuses to start. The local fallback must name the configured local provider.
PA_MODEL_REMOTE_PROVIDER_ID=remote.openai
PA_MODEL_REMOTE_BASE_URL=
PA_MODEL_REMOTE_MODEL=
PA_MODEL_REMOTE_SECRET_HANDLE=
PA_MODEL_REMOTE_TIMEOUT_SECONDS=60
PA_MODEL_LOCAL_PROVIDER_ID=local.ollama
PA_MODEL_LOCAL_BASE_URL=
PA_MODEL_LOCAL_MODEL=
PA_MODEL_LOCAL_TIMEOUT_SECONDS=120
PA_MODEL_LOCAL_FALLBACK_PROVIDER_ID=
